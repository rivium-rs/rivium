+//! The alarm: warns when the reading is above a threshold, checked periodically.
+
+use std::time::Duration;
+
+use rivium::Service;
+use serde::{Deserialize, Serialize};
+
+use crate::meter::Reading;
+
+/// `[alarm]`
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct AlarmSettings {
+    /// The highest reading that is fine.
+    pub threshold: f64,
+    /// How often the reading is checked.
+    #[serde(
+        serialize_with = "rivium::config::de::serialize_duration",
+        deserialize_with = "rivium::config::de::duration::<_, 1, 3600>"
+    )]
+    pub every: Duration,
+}
+
+impl Default for AlarmSettings {
+    fn default() -> Self {
+        AlarmSettings {
+            threshold: 28.0,
+            every: Duration::from_secs(5),
+        }
+    }
+}
+
+/// The alarm: a background service.
+#[must_use]
+pub fn alarm(settings: &AlarmSettings, reading: &Reading) -> Box<dyn Service> {
+    let (threshold, reading) = (settings.threshold, reading.clone());
+    rivium::periodic("alarm", settings.every, move || {
+        let value = reading.get();
+        async move {
+            if value > threshold {
+                tracing::warn!(value, threshold, "reading above the threshold");
+            }
+            Ok(())
+        }
+    })
+}

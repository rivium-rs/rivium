@@ -52,3 +53,29 @@ pub struct CollectorConfig {
     /// `[collect]`
     pub collect: CollectSettings,
 }
+
+/// The `monitor` program: samples the meter and warns when the reading is too high.
+pub struct Monitor;
+
+impl App for Monitor {
+    const NAME: &'static str = "monitor";
+    const VERSION: &'static str = env!("CARGO_PKG_VERSION");
+    type Config = MonitorConfig;
+
+    fn services(config: &MonitorConfig, _: &AppContext) -> Result<Vec<Box<dyn Service>>> {
+        let reading = Reading::default();
+        Ok(vec![
+            meter::sampler(&config.sampler, &reading),
+            alarm::alarm(&config.alarm, &reading),
+        ])
+    }
+}
+
+/// The configuration of `monitor`.
+#[derive(Clone, Debug, Default, Serialize, Deserialize)]
+pub struct MonitorConfig {
+    /// `[sampler]`
+    pub sampler: SamplerSettings,
+    /// `[alarm]`
+    pub alarm: AlarmSettings,
+}
